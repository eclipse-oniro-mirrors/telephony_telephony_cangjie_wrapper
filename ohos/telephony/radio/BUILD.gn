import("//build/templates/cangjie/cjc.gni")

ohos_cangjie_shared_library("ohos.telephony.radio") {
  if (is_mingw || is_mac) {
    sources = [
      "radio_types.cj",
      "../../../mock/ohos.telephony.radio.cj",
    ]
  } else {
    sources = [
      "radio_types.cj",
      "radio_ffi.cj",
      "radio.cj",
    ]

    external_deps = [ "core_service:cj_radio_ffi" ]
  }

  cj_external_deps = [
    "cangjie_ark_interop:ohos.business_exception",
    "cangjie_ark_interop:ohos.labels",
  ]

  subsystem_name = "telephony"
  part_name = "telephony_cangjie_wrapper"
}
